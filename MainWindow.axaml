<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todo"
        mc:Ignorable="d"
        x:Class="Todo.MainWindow"
        Title="Focal Point" Icon="icon.ico" Height="760" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Styles>
        <!-- Strikethrough classes for completed tasks/subtasks -->
        <Style Selector="TextBlock.CompletedText">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*">

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="auto,auto,auto,*,auto,auto,auto" Margin="20,25">

                <!-- Focal Point Brand Logo & Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,30">
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="✓" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Focal Point" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Views -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15" Spacing="4">
                    <TextBlock Text="MENU" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="10,0,0,10" LetterSpacing="1" />
                    
                    <RadioButton Content="Active Tasks"
                                 IsChecked="{Binding IsAllTasksViewActive, Mode=TwoWay}"
                                 Classes="SidebarButton" />
                    
                    <RadioButton Content="Completed Tasks"
                                 IsChecked="{Binding IsFinishedViewActive, Mode=TwoWay}"
                                 Classes="SidebarButton" />
                </StackPanel>

                <!-- Categories Section Header -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,5,10,10" Margin="0,15,0,0">
                    <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" LetterSpacing="1" />
                </Border>

                <!-- Categories List -->
                <ListBox Grid.Row="3" 
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,5">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="4,0,0,0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Padding" Value="15,10" />
                            <Setter Property="CornerRadius" Value="20" /> <!-- Rounded Pill hover -->
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="#F3F4F6" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,auto">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Grid.Column="1" 
                                        Content="×" 
                                        Command="{Binding $parent[Window].DataContext.DeleteCategoryCommand}" 
                                        CommandParameter="{Binding}"
                                        Classes="TextButton"
                                        Foreground="{DynamicResource DangerBrush}"
                                        FontSize="16"
                                        Padding="4,0"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Add Category Button -->
                <Button Grid.Row="4" 
                        Content="+ Add Category" 
                        Command="{Binding OpenAddCategoryDialogCommand}" 
                        Classes="TextButton" 
                        Foreground="{DynamicResource PrimaryBrush}"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        Margin="5,10,0,15" />

                <!-- Database Management Section -->
                <StackPanel Grid.Row="5" Margin="0,15,0,0">
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="5,15,5,5">
                        <TextBlock Text="DATA MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" LetterSpacing="1" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="5,5,0,0">
                        <Button Content="Backup Data" 
                                Command="{Binding ExportDatabaseCommand}" 
                                Classes="TextButton" 
                                Foreground="{DynamicResource PrimaryBrush}"
                                Padding="0" />
                        <TextBlock Text="|" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Restore Data" 
                                Command="{Binding ImportDatabaseCommand}" 
                                Classes="TextButton" 
                                Foreground="{DynamicResource PrimaryBrush}"
                                Padding="0" />
                    </StackPanel>
                </StackPanel>

                <!-- Dark Mode Toggle Switch -->
                <Border Grid.Row="6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="5,15,5,0" Margin="0,15,0,0">
                    <Grid ColumnDefinitions="*,auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌙" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Dark Mode" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                      OnContent="" 
                                      OffContent="" 
                                      MinWidth="0" 
                                      Margin="0"
                                      Padding="0"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1" RowDefinitions="auto,auto,*" Margin="30,30">

            <!-- Top Header Bar (Modern 2-Row Layout with Divider) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <!-- Row 0: Title and Create Button -->
                <Grid ColumnDefinitions="*,auto" Margin="0,0,0,15">
                    <TextBlock Grid.Column="0" Text="Tasks" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    
                    <Button Grid.Column="1" Content="+ Create Task" 
                            Command="{Binding OpenAddTaskDialogCommand}" 
                            Classes="ModernButton" 
                            Padding="18,10"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Thin Horizontal Line Separator -->
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15" />

                <!-- Row 1: Search and Export Actions -->
                <Grid ColumnDefinitions="auto,*,auto">
                    <!-- Search Box on the Left -->
                    <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}"
                             Classes="SearchTextBox"
                             Width="240"
                             Height="36"
                             Watermark="Search"
                             VerticalAlignment="Center" />

                    <!-- Reports Generation Buttons on the Right -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Generate PDF" 
                                Command="{Binding GenerateReportCommand}" 
                                Classes="AccentButton" 
                                Margin="0,0,12,0"
                                Padding="15,8"
                                FontSize="12"
                                FontWeight="Bold"/>

                        <Button Content="Generate Excel" 
                                Command="{Binding GenerateExcelReportCommand}" 
                                Classes="AccentButton" 
                                Padding="15,8"
                                FontSize="12"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Table / List / Kanban Horizontal Capsule Switchers -->
            <Border Grid.Row="1" Margin="0,0,0,20" VerticalAlignment="Center">
                <Grid ColumnDefinitions="auto,*,auto">
                    <!-- Switch Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <!-- Kanban Board Tab -->
                        <RadioButton Content="📋 Kanban Board"
                                     IsChecked="{Binding IsAllTasksViewActive, Mode=TwoWay}"
                                     Classes="SidebarButton"
                                     Theme="{StaticResource {x:Type RadioButton}}"
                                     Padding="15,8"
                                     Height="34"
                                     VerticalAlignment="Center"/>
                        <!-- Completed Tasks Tab -->
                        <RadioButton Content="👁 Completed List"
                                     IsChecked="{Binding IsFinishedViewActive, Mode=TwoWay}"
                                     Classes="SidebarButton"
                                     Theme="{StaticResource {x:Type RadioButton}}"
                                     Padding="15,8"
                                     Height="34"
                                     VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Filter status combo (visible only in completed view) -->
                    <Border Grid.Column="2" 
                            Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource DividerBrush}" 
                            BorderThickness="1" 
                            CornerRadius="20" 
                            Padding="15,4"
                            IsVisible="{Binding IsFinishedViewActive}"
                            VerticalAlignment="Center"
                            Height="34">
                        <Grid ColumnDefinitions="auto,*">
                            <TextBlock Text="Status Filter: " VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding CompletedSubCategories}"
                                      SelectedItem="{Binding SelectedCompletedSubCategory, Mode=TwoWay}"
                                      Width="160"
                                      Height="26"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="12"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Tasks List Container (Jira-style Kanban Board with Floating Cards) -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,10,0,0" IsVisible="{Binding !IsFinishedViewActive}">
                
                <!-- TO DO COLUMN (Transparent Column with Floating Cards) -->
                <Border Grid.Column="0" Background="Transparent" CornerRadius="0" Padding="0" Margin="0,0,15,0" BorderThickness="0">
                    <Grid RowDefinitions="auto,*">
                        <Border Grid.Row="0" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,auto,auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="To Do" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TodoTasks.Count, StringFormat='({0})'}" FontSize="14" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+" Classes="TextButton" Foreground="#9CA3AF" FontSize="14" Padding="6,2" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="2" Text="..." Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding TodoTasks}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 DragDrop.AllowDrop="True"
                                 Name="TodoDropZone">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- White, Rounded, Soft-Shadow Floating Card -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                                            CornerRadius="12" 
                                            Padding="15" 
                                            Margin="0,0,0,12" 
                                            BorderBrush="{DynamicResource DividerBrush}" 
                                            BorderThickness="1" 
                                            BoxShadow="0 4 12 0 #0D000000"
                                            Name="TaskCard" 
                                            PointerPressed="TaskCard_PointerPressed">
                                        <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto">
                                            <!-- Card Top Info: Category Badge & Date -->
                                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                                <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="8,3" IsVisible="{Binding !!Category}">
                                                    <TextBlock Text="{Binding Category.Name}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DateStarted, StringFormat='{}{0:MM/dd}'}" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Delete card action -->
                                            <Button Grid.Column="1" Grid.Row="0" Content="✕" Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Classes="TextButton" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Top" Padding="4"/>

                                            <!-- Card Body: Title & Description -->
                                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding !!Description}"/>
                                            </StackPanel>

                                            <!-- Card Bottom: Status Tag & User Avatar Mockup -->
                                            <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" ColumnDefinitions="*,auto" Margin="0,12,0,0">
                                                <!-- Status Badge (Slack, Gmail, GitHub style) -->
                                                <Border Grid.Column="0" Background="#FFF3E0" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding !!SubCategory}">
                                                    <TextBlock Text="{Binding SubCategory}" FontSize="9.5" FontWeight="Bold" Foreground="#E65100"/>
                                                </Border>
                                                <!-- Circular User Avatar with initials matching reference image -->
                                                <Border Grid.Column="1" Background="#E5E7EB" CornerRadius="12" Width="24" Height="24" BorderBrush="#FFFFFF" BorderThickness="1.5">
                                                    <TextBlock Text="DR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- IN PROGRESS COLUMN -->
                <Border Grid.Column="1" Background="Transparent" CornerRadius="0" Padding="0" Margin="0,0,15,0" BorderThickness="0">
                    <Grid RowDefinitions="auto,*">
                        <Border Grid.Row="0" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,auto,auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="In Progress" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding InProgressTasks.Count, StringFormat='({0})'}" FontSize="14" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+" Classes="TextButton" Foreground="#9CA3AF" FontSize="14" Padding="6,2" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="2" Text="..." Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding InProgressTasks}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 DragDrop.AllowDrop="True"
                                 Name="InProgressDropZone">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- White, Rounded, Soft-Shadow Floating Card -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                                            CornerRadius="12" 
                                            Padding="15" 
                                            Margin="0,0,0,12" 
                                            BorderBrush="{DynamicResource DividerBrush}" 
                                            BorderThickness="1" 
                                            BoxShadow="0 4 12 0 #0D000000"
                                            Name="TaskCard" 
                                            PointerPressed="TaskCard_PointerPressed">
                                        <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto">
                                            <!-- Card Top Info -->
                                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                                <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="8,3" IsVisible="{Binding !!Category}">
                                                    <TextBlock Text="{Binding Category.Name}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DateStarted, StringFormat='{}{0:MM/dd}'}" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Grid.Row="0" Content="✕" Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Classes="TextButton" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Top" Padding="4"/>

                                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding !!Description}"/>
                                            </StackPanel>

                                            <!-- Card Bottom -->
                                            <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" ColumnDefinitions="*,auto" Margin="0,12,0,0">
                                                <Border Grid.Column="0" Background="#FFF3E0" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding !!SubCategory}">
                                                    <TextBlock Text="{Binding SubCategory}" FontSize="9.5" FontWeight="Bold" Foreground="#E65100"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="12" Width="24" Height="24" BorderBrush="#FFFFFF" BorderThickness="1.5">
                                                    <TextBlock Text="LA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- DONE COLUMN -->
                <Border Grid.Column="2" Background="Transparent" CornerRadius="0" Padding="0" BorderThickness="0">
                    <Grid RowDefinitions="auto,*">
                        <Border Grid.Row="0" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,auto,auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Done" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DoneTasks.Count, StringFormat='({0})'}" FontSize="14" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+" Classes="TextButton" Foreground="#9CA3AF" FontSize="14" Padding="6,2" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="2" Text="..." Foreground="#9CA3AF" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding DoneTasks}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 DragDrop.AllowDrop="True"
                                 Name="DoneDropZone">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- White, Rounded, Soft-Shadow Floating Card -->
                                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                                            CornerRadius="12" 
                                            Padding="15" 
                                            Margin="0,0,0,12" 
                                            BorderBrush="{DynamicResource DividerBrush}" 
                                            BorderThickness="1" 
                                            BoxShadow="0 4 12 0 #0D000000"
                                            Name="TaskCard" 
                                            PointerPressed="TaskCard_PointerPressed">
                                        <Grid ColumnDefinitions="*,auto" RowDefinitions="auto,auto,auto">
                                            <!-- Card Top Info -->
                                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                                <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="8,3" IsVisible="{Binding !!Category}">
                                                    <TextBlock Text="{Binding Category.Name}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DateStarted, StringFormat='{}{0:MM/dd}'}" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Grid.Row="0" Content="✕" Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Classes="TextButton" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Top" Padding="4"/>

                                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Classes="Strikethrough"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding !!Description}" Classes="Strikethrough"/>
                                            </StackPanel>

                                            <!-- Card Bottom -->
                                            <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" ColumnDefinitions="*,auto" Margin="0,12,0,0">
                                                <Border Grid.Column="0" Background="#FFF3E0" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" IsVisible="{Binding !!SubCategory}">
                                                    <TextBlock Text="{Binding SubCategory}" FontSize="9.5" FontWeight="Bold" Foreground="#E65100"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="#D1FAE5" CornerRadius="12" Width="24" Height="24" BorderBrush="#FFFFFF" BorderThickness="1.5">
                                                    <TextBlock Text="Done" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>
                </Border>
                
            </Grid>

            <!-- Completed Tasks List Container (Legacy Flat List - White Floating Cards style) -->
            <Grid Grid.Row="2" IsVisible="{Binding IsFinishedViewActive}">
                <ListBox ItemsSource="{Binding DoneTasks}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,5,0,0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- White Floating card list style -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" 
                                    CornerRadius="12" 
                                    Padding="15" 
                                    Margin="0,0,0,12" 
                                    BorderBrush="{DynamicResource DividerBrush}" 
                                    BorderThickness="1" 
                                    BoxShadow="0 4 12 0 #0D000000">
                                <Grid ColumnDefinitions="auto,*,auto">
                                    <!-- CheckBox -->
                                    <CheckBox IsChecked="{Binding IsFinished, Mode=OneWay}"
                                              Command="{Binding $parent[Window].DataContext.ToggleTaskStatusCommand}"
                                              CommandParameter="{Binding}"
                                              VerticalAlignment="Center" />

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" Margin="15,0,15,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Classes="Strikethrough" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="{Binding !!Description}" Classes="Strikethrough" />
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
                                            <!-- Category tag -->
                                            <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="8,3" IsVisible="{Binding !!Category}">
                                                <TextBlock Text="{Binding Category.Name}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                                            </Border>
                                            <!-- Status tag -->
                                            <Border Background="#FFF3E0" CornerRadius="10" Padding="8,3" IsVisible="{Binding !!SubCategory}">
                                                <TextBlock Text="{Binding SubCategory}" FontSize="9.5" FontWeight="Bold" Foreground="#E65100" />
                                            </Border>
                                            <!-- Subtask Count -->
                                            <TextBlock Text="{Binding Subtasks.Count, StringFormat='{}{0} Subtasks'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <!-- Started date -->
                                            <TextBlock Text="{Binding DateStarted, StringFormat='Started: {0:yyyy-MM-dd}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <!-- Finished date -->
                                            <TextBlock Text="{Binding DateFinished, StringFormat='Completed: {0:yyyy-MM-dd}'}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsFinished}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Delete and Edit -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                                        <Button Content="Edit" Command="{Binding $parent[Window].DataContext.OpenEditTaskDialogCommand}" CommandParameter="{Binding}" Classes="TextButton" Foreground="{DynamicResource PrimaryBrush}" FontSize="13" FontWeight="Bold" Padding="8,5" />
                                        <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Classes="TextButton" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="Bold" Padding="8,5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- ================= TASK DETAILS & SUBTASKS OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" 
              Background="#80000000" 
              IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="12" 
                    Width="460" 
                    MaxHeight="600"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto,*,auto" DataContext="{Binding SelectedTask}">

                    <!-- Detail Panel Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,auto" Margin="0,0,0,15">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        
                        <!-- Close button resets selected task to null -->
                        <Button Grid.Column="1" 
                                Content="✕" 
                                Command="{Binding $parent[Window].DataContext.CloseTaskDetailsCommand}" 
                                Classes="TextButton"
                                FontSize="16"
                                FontWeight="Bold"
                                Padding="5"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- Meta Info Card / Description -->
                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <!-- Description -->
                            <TextBlock Text="Description" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            
                            <!-- Empty description case -->
                            <TextBlock Text="No description provided." FontStyle="Italic" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                                       IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNull}}" />
                            <!-- Normal description case -->
                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />

                            <!-- Dates -->
                            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Date Started" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DateStarted, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Date Completed" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <!-- Completed -->
                                    <TextBlock Text="{Binding DateFinished, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"
                                               IsVisible="{Binding IsFinished}" />
                                    <!-- Pending -->
                                    <TextBlock Text="Pending" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"
                                               IsVisible="{Binding !IsFinished}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Primary Actions (Edit / Delete inside details sheet) -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,15">
                        <Button Grid.Column="0" Content="Edit Task" 
                                Command="{Binding $parent[Window].DataContext.OpenEditTaskDialogCommand}" 
                                CommandParameter="{Binding}"
                                Classes="ModernButton" 
                                Margin="0,0,8,0"
                                FontSize="13"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Delete Task" 
                                Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}" 
                                CommandParameter="{Binding}"
                                Classes="DangerButton" 
                                FontSize="13"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </Grid>

                    <!-- Subtasks List Section -->
                    <Grid Grid.Row="3" RowDefinitions="auto,*" Margin="0,0,0,15">
                        <!-- Subtasks Header -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,8">
                            <TextBlock Text="SUBTASKS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Subtasks Scrollable List -->
                        <ScrollViewer Grid.Row="1" MaxHeight="180">
                            <ListBox ItemsSource="{Binding Subtasks}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="auto,*,auto" Margin="2">
                                            <!-- Toggle Subtask Status -->
                                            <CheckBox IsChecked="{Binding IsFinished, Mode=OneWay}"
                                                      Command="{Binding $parent[Window].DataContext.ToggleSubtaskStatusCommand}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center" />

                                            <!-- Subtask Title -->
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                       Classes.CompletedText="{Binding IsFinished}" />

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2" 
                                                    Content="×" 
                                                    Command="{Binding $parent[Window].DataContext.DeleteSubtaskCommand}" 
                                                    CommandParameter="{Binding}"
                                                    Classes="TextButton"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    FontSize="18"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>

                    <!-- Add Subtask Button -->
                    <Button Grid.Row="4" 
                            Content="+ Add Subtask" 
                            Command="{Binding $parent[Window].DataContext.OpenAddSubtaskDialogCommand}" 
                            Classes="ModernButton" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= TASK ADD/EDIT OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" 
              Background="#80000000" 
              IsVisible="{Binding IsTaskDialogVisible}">
            <Border Background="White" 
                    CornerRadius="12" 
                    Width="450" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto">

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Add New Task" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,20" IsVisible="{Binding !IsEditMode}" />
                    <TextBlock Grid.Row="0" Text="Edit Task" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,20" IsVisible="{Binding IsEditMode}" />

                    <!-- Fields -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <!-- Task Title -->
                        <TextBlock Text="Title" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DialogTaskTitle, Mode=TwoWay}" Classes="ModernTextBox" Height="35" Margin="0,0,0,15" />

                        <!-- Task Description -->
                        <TextBlock Text="Description" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding DialogTaskDescription, Mode=TwoWay}" Classes="ModernTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15" />

                        <!-- Task Category Selector -->
                        <TextBlock Text="Category" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding DialogTaskCategory, Mode=TwoWay}" 
                                  Width="400"
                                  Height="35"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CloseTaskDialogCommand}" 
                                Classes="TextButton" 
                                Margin="0,0,10,0" 
                                Width="80" />
                        
                        <Button Content="Save" 
                                Command="{Binding SaveTaskCommand}" 
                                Classes="ModernButton" 
                                Width="100" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= CATEGORY ADD OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" 
              Background="#80000000" 
              IsVisible="{Binding IsCategoryDialogVisible}">
            <Border Background="White" 
                    CornerRadius="12" 
                    Width="380" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto">

                    <TextBlock Grid.Row="0" Text="Add New Category" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,20" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Category Name" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding NewCategoryName, Mode=TwoWay}" Classes="ModernTextBox" Height="35" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CloseCategoryDialogCommand}" 
                                Classes="TextButton" 
                                Margin="0,0,10,0" 
                                Width="80" />
                        
                        <Button Content="Add" 
                                Command="{Binding AddCategoryCommand}" 
                                Classes="ModernButton" 
                                Width="100" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= SUBTASK ADD OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" 
              Background="#80000000" 
              IsVisible="{Binding IsSubtaskDialogVisible}">
            <Border Background="White" 
                    CornerRadius="12" 
                    Width="380" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto">

                    <TextBlock Grid.Row="0" Text="Add New Subtask" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,20" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Subtask Title" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding NewSubtaskTitle, Mode=TwoWay}" Classes="ModernTextBox" Height="35" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CloseSubtaskDialogCommand}" 
                                Classes="TextButton" 
                                Margin="0,0,10,0" 
                                Width="80" />
                        
                        <Button Content="Add" 
                                Command="{Binding AddSubtaskCommand}" 
                                CommandParameter="{Binding SelectedTask}"
                                Classes="ModernButton" 
                                Width="100" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= COMPLETE TASK / SUB-CATEGORY OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" 
              Background="#80000000" 
              IsVisible="{Binding IsCompleteTaskDialogVisible}">
            <Border Background="White" 
                    CornerRadius="12" 
                    Width="400" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto">

                    <TextBlock Grid.Row="0" Text="Complete Task" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,15" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Specify a Status (Optional)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Adding a status helps filter completed tasks and groups them in reports." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        
                        <TextBox Text="{Binding CompleteTaskSubCategory, Mode=TwoWay}" 
                                 Classes="ModernTextBox" 
                                 Watermark="e.g., Working, Completed, Testing..."
                                 Height="40" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Command="{Binding CloseCompleteTaskDialogCommand}" 
                                Classes="TextButton" 
                                Margin="0,0,10,0" 
                                Width="80" />
                        
                        <Button Content="Complete Task" 
                                Command="{Binding SaveCompleteTaskCommand}" 
                                Classes="ModernButton" 
                                Background="{DynamicResource SuccessBrush}"
                                Width="130" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= CUSTOM CONFIRM OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" 
              Background="#80000000" 
              IsVisible="{Binding IsConfirmDialogVisible}">
            <Border Background="White" 
                    CornerRadius="12" 
                    Width="400" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto">
                    <TextBlock Grid.Row="0" Text="{Binding ConfirmTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,15" />
                    
                    <TextBlock Grid.Row="1" Text="{Binding ConfirmMessage}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="No" 
                                Command="{Binding CancelConfirmCommand}" 
                                Classes="TextButton" 
                                Margin="0,0,10,0" 
                                Width="80" />
                        
                        <Button Content="Yes" 
                                Command="{Binding ConfirmCommand}" 
                                Classes="DangerButton" 
                                Width="100" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= CUSTOM ALERT OVERLAY MODAL ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="3" 
              Background="#80000000" 
              IsVisible="{Binding IsAlertDialogVisible}">
            <Border Background="White" 
                    CornerRadius="12" 
                    Width="380" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="25"
                    BoxShadow="0 8 24 0 #1A000000">
                <Grid RowDefinitions="auto,auto,auto">
                    <TextBlock Grid.Row="0" Text="Information" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,15" />
                    
                    <TextBlock Grid.Row="1" Text="{Binding AlertMessage}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <Button Grid.Row="2" 
                            Content="OK" 
                            Command="{Binding CloseAlertDialogCommand}" 
                            Classes="ModernButton" 
                            Width="120"
                            HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
