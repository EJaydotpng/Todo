<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Todo.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Mode Color Palette -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />        <!-- Bright Blue -->
                    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2563EB" />    <!-- Hover Blue -->
                    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EFF6FF" />   <!-- Soft Blue -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />         <!-- Coordinated Blue -->
                    <SolidColorBrush x:Key="BackgroundBrush" Color="#F9FAFB" />     <!-- Ultra-light Grey Canvas -->
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" /> <!-- Pure White -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />    <!-- Slate 900 -->
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />  <!-- Gray 500 -->
                    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />        <!-- Light Gray border -->
                    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />        <!-- Emerald Green -->
                    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />        <!-- Amber Yellow -->
                    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />         <!-- Rose Red -->
                    
                    <SolidColorBrush x:Key="LogoBrush" Color="#3A82F6" />           <!-- Bright Blue Logo -->
                    <StreamGeometry x:Key="LogoGeometry">M 185.5 0.5 V 5 C 185.5 26.8152 167.815 44.5 146 44.5 H 44.5 V 110.671 L 113.049 117.806 C 119.84 118.512 125 124.236 125 131.064 C 125 138.053 119.602 143.856 112.632 144.36 L 44.5 149.293 V 259.5 H 40 C 18.1848 259.5 0.5 241.815 0.5 220 V 22.5 C 0.5 10.3497 10.3497 0.5 22.5 0.5 H 185.5 Z M 107.821 59.5 L 107.948 59.585 C 126.462 71.9917 140.351 83.0563 149.607 93.46 C 158.865 103.865 163.5 123.502 163.5 123.502 C 163.47 133.347 158.746 143.136 149.475 153.54 C 140.297 163.839 126.621 174.784 108.5 187.04 V 259.5 H 64.5 V 186.902 L 64.7871 186.768 L 91.0674 174.409 C 104.319 167.496 114.23 161.179 121.194 155.16 C 132.018 145.805 135.637 137.263 133.766 128.401 C 131.877 119.458 124.378 110.039 112.521 99.0244 C 103.724 90.8513 92.5839 81.8491 79.6797 71.5527 L 76.707 69.4053 L 76.7002 69.4004 L 64.7002 60.4004 L 63.5 59.5 H 107.821 Z M 144 228.5 C 152.56 228.5 159.5 235.44 159.5 244 C 159.5 252.56 152.56 259.5 144 259.5 C 135.44 259.5 128.5 252.56 128.5 244 C 128.5 235.44 135.44 228.5 144 228.5 Z</StreamGeometry>
                </ResourceDictionary>

                <!-- Dark Mode Color Palette -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />        <!-- Bright Blue -->
                    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#60A5FA" />    <!-- Lighter Blue for Dark Mode -->
                    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1E293B" />   <!-- Soft Dark Blue / Slate 800 -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A" />     <!-- Slate 900 Canvas -->
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" /> <!-- Slate 800 Card -->
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB" />    <!-- Bright White Text -->
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />  <!-- Soft Gray Text -->
                    <SolidColorBrush x:Key="DividerBrush" Color="#334155" />        <!-- Dark Slate Border -->
                    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />        <!-- Bright Green -->
                    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />        <!-- Amber Yellow -->
                    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />         <!-- Soft Red -->
                    
                    <SolidColorBrush x:Key="LogoBrush" Color="#D9D9D9" />           <!-- Off-white Logo -->
                    <StreamGeometry x:Key="LogoGeometry">M 185.5 0.5 V 5 C 185.5 26.4744 168.364 43.9465 147.02 44.4873 L 146 44.5 H 44.5 V 110.671 L 113.049 117.806 C 119.84 118.512 125 124.236 125 131.064 C 125 138.053 119.602 143.856 112.632 144.36 L 44.5 149.293 V 259.5 H 40 C 18.1848 259.5 0.5 241.815 0.5 220 V 22.5 C 0.5 10.3497 10.3497 0.5 22.5 0.5 H 185.5 Z M 107.821 59.5 L 107.948 59.585 C 126.462 71.9917 140.351 83.0563 149.607 93.46 C 158.865 103.865 163.5 123.502 163.5 123.502 C 163.47 133.347 158.746 143.136 149.475 153.54 C 140.297 163.839 126.621 174.784 108.5 187.04 V 259.5 H 64.5 V 186.902 L 64.7871 186.768 L 91.0674 174.409 C 104.319 167.496 114.23 161.179 121.194 155.16 C 132.018 145.805 135.637 137.263 133.766 128.401 C 131.877 119.458 124.378 110.039 112.521 99.0244 C 103.724 90.8513 92.5839 81.8491 79.6797 71.5527 L 76.707 69.4053 L 76.7002 69.4004 L 64.7002 60.4004 L 63.5 59.5 H 107.821 Z M 144 228.5 C 152.56 228.5 159.5 235.44 159.5 244 C 159.5 252.56 152.56 259.5 144 259.5 C 135.44 259.5 128.5 252.56 128.5 244 C 128.5 235.44 135.44 228.5 144 228.5 Z</StreamGeometry>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Modern Pill Button Style -->
        <Style Selector="Button.ModernButton">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" /> <!-- Rounded Pill! -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ModernButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
        </Style>
        <Style Selector="Button.ModernButton:disabled">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- Accent Button Style -->
        <Style Selector="Button.AccentButton">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" /> <!-- Rounded Pill! -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.AccentButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- TextButton Style -->
        <Style Selector="Button.TextButton">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TextButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
        </Style>

        <!-- Danger Button Style -->
        <Style Selector="Button.DangerButton">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" /> <!-- Rounded Pill! -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DangerButton:pointerover">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <!-- Modern TextBox Style -->
        <Style Selector="TextBox.ModernTextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBox.ModernTextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.ModernTextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- Search TextBox Style with Watermark -->
        <Style Selector="TextBox.SearchTextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="15,8,10,8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="20" /> <!-- Capsule! -->
            <Setter Property="Watermark" Value="Search tasks..." />
        </Style>
        <Style Selector="TextBox.SearchTextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.SearchTextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <!-- Sidebar Navigation Items (Capsule Pill active selection) -->
        <Style Selector="RadioButton.SidebarButton">
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" /> <!-- Fully rounded capsule! -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SidebarButton:checked">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" /> <!-- Solid Blue selection! -->
            <Setter Property="Foreground" Value="White" />                         <!-- White Text! -->
        </Style>
        <Style Selector="RadioButton.SidebarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" /> <!-- Responsive Hover! -->
        </Style>
    </Application.Styles>
</Application>
